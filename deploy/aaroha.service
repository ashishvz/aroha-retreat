[Unit]
Description=Aaroha Retreats site + booking API
After=network.target

[Service]
Type=simple
User=ashishvz
WorkingDirectory=/home/ashishvz/aaroha
# ADMIN_PASSWORD=... lives here (chmod 600), never in the repo
EnvironmentFile=/home/ashishvz/aaroha/.env
ExecStart=/usr/bin/python3 /home/ashishvz/aaroha/server/app.py --port 8088
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
